# ------------------------------------------------------------------------------
# App / General Configuration
# Maps to basecfg.App (type Cfg)
# ------------------------------------------------------------------------------
IDENTITY_SVC__CFG__SHUTDOWN_TIMEOUT=30s

# ------------------------------------------------------------------------------
# gRPC Server Configuration
# Maps to basecfg.Grpc
# ------------------------------------------------------------------------------
IDENTITY_SVC__GRPC__PORT=50051
IDENTITY_SVC__GRPC__MAX_STREAMS=100
IDENTITY_SVC__GRPC__MAX_REQUESTS=1000
IDENTITY_SVC__GRPC__TLS__ENABLED=false

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# Maps to basecfg.PostgreSQL
# ------------------------------------------------------------------------------
IDENTITY_SVC__POSTGRESQL__HOST=localhost
IDENTITY_SVC__POSTGRESQL__PORT=5432
IDENTITY_SVC__POSTGRESQL__USER=postgres
IDENTITY_SVC__POSTGRESQL__PASSWORD=securepassword
IDENTITY_SVC__POSTGRESQL__DATABASE=identity_db
IDENTITY_SVC__POSTGRESQL__MAX_OPEN_CONNS=25
IDENTITY_SVC__POSTGRESQL__MAX_IDLE_CONNS=5
IDENTITY_SVC__POSTGRESQL__CONN_MAX_LIFETIME=1h
IDENTITY_SVC__POSTGRESQL__RECONNECT_WAIT=5s

# TLS Fields
IDENTITY_SVC__POSTGRESQL__TLS__ENABLED=false
IDENTITY_SVC__POSTGRESQL__TLS__SSL=disabled

# ------------------------------------------------------------------------------
# NATS Configuration
# Maps to basecfg.Nats
# ------------------------------------------------------------------------------
IDENTITY_SVC__NATS__URLS=nats://localhost:4222
IDENTITY_SVC__NATS__MAX_RECONNECTS=10
IDENTITY_SVC__NATS__RECONNECT_WAIT=2s
IDENTITY_SVC__NATS__TLS__ENABLED=false

# ------------------------------------------------------------------------------
# Redis Configuration
# Maps to basecfg.Redis
# ------------------------------------------------------------------------------
IDENTITY_SVC__REDIS__ADDR=redis://localhost:6379
IDENTITY_SVC__REDIS__USERNAME=default
IDENTITY_SVC__REDIS__PASSWORD=redissecret
IDENTITY_SVC__REDIS__DIAL_TIMEOUT=5s
IDENTITY_SVC__REDIS__RECONNECT_WAIT=2s
IDENTITY_SVC__REDIS__READ_TIMEOUT=3s
IDENTITY_SVC__REDIS__WRITE_TIMEOUT=3s
IDENTITY_SVC__REDIS__MAXR_RETRY_BACKOFF=512ms
IDENTITY_SVC__REDIS__MIN_RETRY_BACKOFF=8ms
IDENTITY_SVC__REDIS__MAX_RETRIES=3
IDENTITY_SVC__REDIS__POOL_SIZE=10
IDENTITY_SVC__REDIS__POOL_TIMEOUT=4s
IDENTITY_SVC__REDIS__MIN_IDLE_CONNS=2
IDENTITY_SVC__REDIS__CONN_MAX_IDLE_TIME=30m

# TLS Fields
IDENTITY_SVC__REDIS__TLS__ENABLED=false